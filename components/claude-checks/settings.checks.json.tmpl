{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "{NODE}",
            "args": [
              "{AGENTS_HOME}/tools/checks/post-edit.mjs"
            ],
            "timeout": 20
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "{NODE}",
            "args": [
              "{AGENTS_HOME}/tools/checks/fanout-nudge.mjs"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "{NODE}",
            "args": [
              "{AGENTS_HOME}/tools/checks/shell-guard.mjs"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{NODE}",
            "args": [
              "{AGENTS_HOME}/tools/checks/done-check.mjs"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "{NODE}",
            "args": [
              "{AGENTS_HOME}/tools/checks/project-map.mjs",
              "--hook"
            ],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
