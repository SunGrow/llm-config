{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{NODE}",
            "args": [
              "{JEV_HOME}/route-hook.mjs"
            ],
            "timeout": 8
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "{NODE}",
            "args": [
              "{JEV_HOME}/gate-hook.mjs"
            ],
            "timeout": 12
          },
          {
            "type": "command",
            "if": "Bash(rm *)",
            "command": "{NODE}",
            "args": [
              "{JEV_HOME}/gate-hook.mjs"
            ],
            "timeout": 12
          }
        ]
      }
    ]
  }
}
